 CellID->74157935,ExpressionUUID->"15cd31ec-80af-40f6-a80e-b2491c3cc177"],

Cell[CellGroupData[{

Cell["\<\
one or more slightly shorter directors in front (they pull energy forward).\
\>", "Item",
