Cell["\<\
The doughnut has collapsed into a single forward beam pointing toward the \
directors (the +y direction, the way the antenna \"points\"). \
\>", "Text",
 CellChangeTimes->{
  3.990200541943589*^9, 3.990200584043126*^9, {3.990200664527944*^9, 
   3.990200670231249*^9}, 3.9902008149406233`*^9},
