 CellLabel->"Out[160]=",
 CellID->358602916,ExpressionUUID->"cf92caa6-84ad-4905-ba99-449d2aa95c8b"]
}, Open  ]]
}, Open  ]],

Cell[TextData[{
 "The reactance is positive (inductive) and nonzero, which means our ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.5`", " ", "m"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "e27af9b4-a0d8-49b6-9787-4b326f39135f"],
 " dipole is not resonant at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"300", " ", "MHz"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"ae067671-be0c-4ed1-baeb-f7a5f97a3995"],
 ". An antenna is resonant when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"X", "\[LongEqual]", "0"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"f5bf2a65-0536-4ca4-b188-8b8f9efe7ddf"],
 " \[LongDash] the reactance cancels out and the source sees a pure \
resistance, which is easiest to feed."
}], "Text",
 CellChangeTimes->{{3.990199516721589*^9, 3.990199539386086*^9}},
 CellID->1205053786,ExpressionUUID->"d09723ca-0434-4e11-946f-6f7aaf35126c"],

Cell[CellGroupData[{

Cell["Let's find the resonant frequency by sweeping:", "MathCaption",
 CellChangeTimes->{3.990199555577033*^9},
 CellID->1688938381,ExpressionUUID->"3c2d6935-92a8-4051-ab4e-f6f0732770f3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweep", " ", "=", " ", 
   RowBox[{"AntennaSweepMemory", "[", 
    RowBox[{"dipole", ",", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"260.0", ",", " ", "310.0", ",", " ", "2.0"}], "]"}], ",", " ", 
     "feed"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"sweep", "[", 
     RowBox[{"All", ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#Frequency", ",", " ", 
         RowBox[{"Im", "[", "#ZInput", "]"}]}], "}"}], " ", "&"}]}], "]"}], 
    "]"}], ",", "\n", "  ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Frequency (MHz)\>\"", ",", 
      " ", "\"\<Reactance X (\[CapitalOmega])\>\""}], "}"}]}], ",", "\n", 
   "  ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", "0", "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotTheme", " ", "->", " ", "\"\<Detailed\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{3.9901995664383917`*^9},
 CellLabel->"In[161]:=",
 CellID->864368347,ExpressionUUID->"dc03d183-cc00-428e-8b89-12f64b766c11"],

