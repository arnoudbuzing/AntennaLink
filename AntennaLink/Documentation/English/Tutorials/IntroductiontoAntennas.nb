Cell[TextData[{
 "The reactance crosses zero near ",
 Cell[BoxData[
  FormBox[
   RowBox[{"284", " ", "MHz"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"245d255d-87e4-40dc-86de-041f8d26e43f"],
 ", not ",
 Cell[BoxData[
  FormBox[
   RowBox[{"300", " ", "MHz"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"6cc52989-7a3f-4e99-8fae-7bdec68ab2be"],
 "."
}], "Text",
 CellChangeTimes->{{3.990199592548531*^9, 3.99019964608528*^9}},
 CellID->1995258965,ExpressionUUID->"32caeddb-fe1d-4ebe-85ac-f89620ccbee4"],

Cell[CellGroupData[{

Cell["There the impedance is:", "MathCaption",
 CellChangeTimes->{{3.990199683262136*^9, 3.990199692516087*^9}},
 CellID->1829843927,ExpressionUUID->"4cceb5cb-767e-4e70-9f91-baf6d1441d05"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"res", " ", "=", " ", 
   RowBox[{
    RowBox[{"MinimalBy", "[", 
     RowBox[{
      RowBox[{"Normal", "[", "sweep", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"Im", "[", "#ZInput", "]"}], "]"}], " ", "&"}]}], "]"}], "[", 
    
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"res", "[", "\"\<Frequency\>\"", "]"}], ",", " ", 
    RowBox[{"res", "[", "\"\<ZInput\>\"", "]"}]}], "}"}], "  "}]}], "Input",
 CellChangeTimes->{3.990199674475301*^9},
 CellLabel->"In[163]:=",
 CellID->2013772152,ExpressionUUID->"2fce8a0e-98cb-47cb-8fef-3deb592987bc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"284.`", ",", 
   RowBox[{"75.24220120233275`", "\[VeryThinSpace]", "-", 
    RowBox[{"2.2554429447647335`", " ", "\[ImaginaryI]"}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.990199675414233*^9},
 CellLabel->"Out[164]=",
 CellID->383472655,ExpressionUUID->"facfe58b-85d6-42ae-bdde-995ed4a73fc7"]
}, Open  ]]
}, Open  ]],

Cell["Two classic lessons fall out of this:", "Text",
 CellChangeTimes->{{3.990199727008293*^9, 3.9901997300202627`*^9}},
 CellID->934154406,ExpressionUUID->"1a8c02de-7094-4244-8de7-4d55ab539b51"],

Cell[TextData[{
 "A real dipole resonates a little short of half a wavelength (here ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.5`", " ", "m"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "1accaef2-838d-4542-b25c-fa91593fa41c"],
 " is resonant at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"284", " ", "MHz"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"7287bddb-da3e-4f15-90f8-de8cc5df078a"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[LongEqual]", 
    RowBox[{"1.055`", " ", "m"}]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"9665228c-ffe3-4d61-9841-033c6dd8c607"],
 ", so the dipole is about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.47`", " ", "\[Lambda]"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"9ecc52ea-29ee-4045-a80e-ef094ea74ce7"],
 ", not ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.5`", " ", "\[Lambda]"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"63af2ae2-7b0c-4940-9fa5-cda947d5a41d"],
 "). End effects and wire thickness make the antenna look slightly longer \
than it is. In practice you cut a dipole to about 95% of ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Lambda]", "2"], TraditionalForm]], "InlineMath",
  ExpressionUUID->"1aae6800-f57c-433e-81e6-3596b840be32"],
 "."
}], "Item",
 CellChangeTimes->{{3.990199727008293*^9, 3.990199815024166*^9}},
 CellID->750402306,ExpressionUUID->"61880c62-bab7-473d-a135-4962bc9c60ca"],

Cell[TextData[{
 "The radiation resistance of a resonant half-wave dipole is about ",
 Cell[BoxData[
  FormBox[
   RowBox[{"73", " ", "\[CapitalOmega]"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"17b82bd0-db25-4624-9eea-e513fa4fd6b5"],
 " \[LongDash] we get ~",
 Cell[BoxData[
  FormBox[
   RowBox[{"75", " ", "\[CapitalOmega]"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"f9306dff-72cc-4c39-bbc0-15ab657d8e4c"],
 ", the textbook value. This is the number to remember."
}], "Item",
 CellChangeTimes->{{3.990199727008293*^9, 3.9901997458692617`*^9}, {
  3.9901998205879707`*^9, 3.990199832600469*^9}},
 CellID->1106686919,ExpressionUUID->"e760c3c5-ab56-4cbe-8da0-750a13d16b41"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Radiation Pattern", "Subsection",
 CellChangeTimes->{{3.990199848100762*^9, 3.99019985739764*^9}},
 CellID->1559960373,ExpressionUUID->"c627c4a4-8149-4e32-9af2-efb33c9c5288"],

Cell["Now the payoff: where does the energy go?", "Text",
 CellChangeTimes->{{3.99019987959639*^9, 3.990199888321858*^9}},
 CellID->737109225,ExpressionUUID->"918d2399-0336-4bbf-9e56-62392639ff1c"],

Cell[CellGroupData[{

Cell["\<\
Compute the far field over a grid of directions and plot it in 3D:\
\>", "MathCaption",
 CellChangeTimes->{{3.99019987959639*^9, 3.9901998871063213`*^9}},
 CellID->1018497935,ExpressionUUID->"57a8662d-8cb2-4e25-9405-5b9de0bd6a18"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ff", " ", "=", " ", 
   RowBox[{"AntennaFarFieldMemory", "[", 
    RowBox[{"dipole", ",", " ", "300.0", ",", " ", "feed", ",", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.0", ",", " ", "180.0", ",", " ", "5.0"}], "]"}], ",", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.0", ",", " ", "360.0", ",", " ", "10.0"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"AntennaPlotPattern3D", "[", 
  RowBox[{"ff", ",", " ", 
   RowBox[{"\"\<ShowGeometry\>\"", " ", "->", " ", "True"}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.990199900756236*^9, 3.990199934171101*^9}},
