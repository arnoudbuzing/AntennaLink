Cell["\<\
You get the famous doughnut: the dipole radiates strongly broadside \
(perpendicular to the wire) and not at all along its own axis.\
\>", "Text",
 CellChangeTimes->{3.990199952859016*^9},
 CellID->1447888455,ExpressionUUID->"3cf404c3-03d8-4aeb-b89d-933800edf5be"],

