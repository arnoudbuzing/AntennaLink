    RowBox[{"All", ",", " ", "\"\<GainDB\>\""}], "]"}], "]"}], "]"}]], "Input",\

 CellChangeTimes->{3.9902001575720987`*^9},
 CellLabel->"In[179]:=",
 CellID->2042020695,ExpressionUUID->"b1216266-c6a2-4299-bc47-51fcf7bbcfc5"],

Cell[BoxData["2.178450489886147`"], "Output",
 CellChangeTimes->{3.990200158166954*^9},
 CellLabel->"Out[179]=",
 CellID->374522600,ExpressionUUID->"96f01f3e-a879-4d8e-b4df-df7d0d073ceb"]
}, Open  ]]
}, Open  ]],

Cell["\<\
A half-wave dipole has a peak gain of about 2.15 dBi \[LongDash] it is 1.64\
\[Times] \"louder\" broadside than an isotropic source would be. That is \
modest; the dipole is nearly omnidirectional. To get real directivity we need \
to shape the pattern, which is the subject of the section on making antennas \
directional.\
\>", "Text",
 CellChangeTimes->{{3.990200203653654*^9, 3.990200274458391*^9}},
 CellID->2105933063,ExpressionUUID->"61dee601-6d44-47c2-b6a9-48a5fbce98f3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Feeding The Antenna: Matching and VSWR", "Subsection",
 CellChangeTimes->{{3.990200369372456*^9, 3.99020037682446*^9}},
 CellID->434170893,ExpressionUUID->"78b240a2-f99e-45c6-a7a5-3ae06d554dd6"],

Cell[TextData[{
 "Transmitters and coaxial cable are usually built for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"50", " ", "\[CapitalOmega]"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"2c2f43aa-b51e-469d-9d11-f0e43da75fa8"],
 ". If the antenna's impedance isn't ",
 Cell[BoxData[
  FormBox[
   RowBox[{"50", " ", "\[CapitalOmega]"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"37d5295d-6dc9-4449-8eb8-66c52d4bbe91"],
 ", some power reflects back from the antenna instead of radiating \
\[LongDash] like an echo on a mismatched transmission line. The standard \
measure of mismatch is the Voltage Standing Wave Ratio (VSWR), computed from \
the reflection coefficient. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"VSWR", "=", "1"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "f9702401-97cb-4b86-81f1-dd0cab44c0ef"],
 " is perfect (no reflection); higher is worse."
}], "Text",
 CellChangeTimes->{{3.9902003970591297`*^9, 3.9902004245874853`*^9}},
 CellID->216042518,ExpressionUUID->"9bac0574-8924-4579-aff4-eca74e5a05d6"],

Cell[CellGroupData[{

Cell["AntennaLink computes this across a sweep for you:", "MathCaption",
 CellChangeTimes->{3.990200439825707*^9},
 CellID->1718000579,ExpressionUUID->"6b3b9d4c-fa36-496e-a6fb-fd0ba78c2e37"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweep", " ", "=", " ", 
   RowBox[{"AntennaSweepMemory", "[", 
    RowBox[{"dipole", ",", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"260.0", ",", " ", "310.0", ",", " ", "1.0"}], "]"}], ",", " ", 
     "feed", ",", " ", 
     RowBox[{"\"\<ReferenceImpedance\>\"", " ", "->", " ", "50.0"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"sweep", "[", 
     RowBox[{"All", ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#Frequency", ",", " ", "#VSWR"}], "}"}], " ", "&"}]}], "]"}],
     "]"}], ",", "\n", "  ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Frequency (MHz)\>\"", ",", " ", "\"\<VSWR\>\""}], "}"}]}], ",",
    " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "6"}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", "2", "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"PlotTheme", " ", "->", " ", "\"\<Detailed\>\""}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{3.990200451998372*^9},
 CellLabel->"In[180]:=",
 CellID->1379635890,ExpressionUUID->"0d4d54ee-8d9a-48af-ac0c-2f5358fe6073"],

