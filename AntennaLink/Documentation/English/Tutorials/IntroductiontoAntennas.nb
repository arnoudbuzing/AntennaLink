Cell["one driven element (a dipole, the only one fed),", "Item",
 CellChangeTimes->{
  3.990200541943589*^9, 3.990200584043126*^9, {3.990200664527944*^9, 
   3.990200670231249*^9}, {3.99020072278432*^9, 3.990200747377851*^9}},
 CellID->1595934025,ExpressionUUID->"a6990cc4-8cfa-42e8-89a3-72b71cf8850b"],

Cell["\<\
one slightly longer reflector behind it (it pushes energy forward),\
\>", "Item",
 CellChangeTimes->{
  3.990200541943589*^9, 3.990200584043126*^9, {3.990200664527944*^9, 
   3.990200670231249*^9}, {3.99020072278432*^9, 3.9902007248083477`*^9}, 
