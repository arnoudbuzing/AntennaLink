Cell[CellGroupData[{

Cell["What Is An Antenna?", "Subsection",
 CellChangeTimes->{{3.990198367269227*^9, 3.9901983764125767`*^9}},
 CellID->710486927,ExpressionUUID->"4cd2ebc3-36c0-4b66-9ddd-9456965107f3"],

Cell["\<\
A transmitter produces an oscillating current in a wire . A fundamental \
result of electromagnetism is that accelerating charge radiates \[LongDash] \
when you push charge back and forth along a conductor, some of the energy \
escapes as an electromagnetic wave that travels outward at the speed of light \
. An antenna is just a conductor shaped so that this happens efficiently and \
in a useful direction . A receiving antenna runs the process in reverse : a \
passing wave pushes charge in the wire, producing a current we can amplify .\
\>", "Text",
 CellChangeTimes->{3.990198429919243*^9},
 CellID->1149976460,ExpressionUUID->"43f1c5c2-a27c-4745-a16c-9199108173c8"],

Cell["\<\
So the whole game is: what current flows on the conductor, and what wave does \
that current produce? That is exactly what AntennaLink computes . Internally \
it uses the Method of Moments (via the NEC - 2 engine): it chops each wire \
into short straight segments, assumes the current is simple on each segment, \
and solves a system of equations so that Maxwell's boundary conditions are \
satisfied everywhere . You describe the metal; it finds the current and the \
radiated field .\
\>", "Text",
 CellChangeTimes->{{3.9901984530837383`*^9, 3.990198468483425*^9}},
 CellID->2072554267,ExpressionUUID->"56c19919-d381-450e-b929-e757d0c696e9"],

Cell[CellGroupData[{

Cell["A wire in AntennaLink is represented with an association:", \
"MathCaption",
 CellChangeTimes->{
  3.990198524068288*^9, {3.990198580977652*^9, 3.99019860728697*^9}},
 CellID->679155365,ExpressionUUID->"e81ecdd0-896d-4dee-b74d-29d3fb3ae2f4"],

Cell[BoxData[
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<Segments\>\"", " ", "->", " ", "21"}], ",", " ", 
   RowBox[{"\"\<Tag\>\"", " ", "->", " ", "1"}], ",", " ", 
   RowBox[{"\"\<P1\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", 
      RowBox[{"-", "0.25"}]}], "}"}]}], ",", " ", 
   RowBox[{"\"\<P2\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0", ",", " ", "0.25"}], "}"}]}], ",", " ", 
   RowBox[{"\"\<Radius\>\"", " ", "->", " ", "0.001"}]}], "|>"}]], "Input",
 CellID->688635750,ExpressionUUID->"ee6a2952-4b85-4686-9bdf-eed24e8d7225"]
}, Open  ]],

Cell[TextData[{
 StyleBox["\"P1\"", "InlineCode"],
 " a",
 "nd \"",
 StyleBox["P2\"", "InlineCode"],
 " are the endpoints in meters, \"",
 StyleBox["Segments\"", "InlineCode"],
 " is how finely it is chopped, \"",
 StyleBox["Tag\"", "InlineCode"],
 " is a label so we can refer to it, and \"",
 StyleBox["Radius\"", "InlineCode"],
 " is the wire thickness . More segments means a more accurate current \
\[LongDash] a good rule of thumb is at least ~10 segments per wavelength of \
wire ."
}], "Text",
 CellChangeTimes->{{3.9901985468832417`*^9, 3.9901985767976913`*^9}, {
  3.990198610466066*^9, 3.9901986544772377`*^9}},
 CellID->1111676567,ExpressionUUID->"6436e334-f3fd-45a8-ab6c-671f7571dbbf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Wavelength \[LongDash] The Ruler For Everything", "Subsection",
 CellChangeTimes->{{3.990198680573407*^9, 3.9901986913694277`*^9}},
 CellID->1833458591,ExpressionUUID->"9d32db91-8e9e-42d7-a105-d3ee5191a30d"],

Cell[TextData[{
 "Antennas have almost no absolute size \[LongDash] what matters is size \
relative to the wavelength of the wave. The wave length \[Lambda] ",
 StyleBox["is ",
  Deletable->True],
 Cell[BoxData[
  FormBox[
   FractionBox["c", "f"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "a9f48854-612d-4f4d-ad80-51f8f35cd6d5"],
 StyleBox[", where ",
  Deletable->True],
 Cell[BoxData[
  FormBox["c", TraditionalForm]], "InlineMath",ExpressionUUID->
  "64a2693f-3aa8-45aa-bde8-1df9f10c97c7"],
 StyleBox[" is the speed of light and ",
  Deletable->True],
 Cell[BoxData[
  FormBox["f", TraditionalForm]], "InlineMath",ExpressionUUID->
  "4e90e889-631d-4ffe-8b2f-be4b60a4e8bb"],
 StyleBox[" is the frequency.",
  Deletable->True],
 " "
}], "Text",
 CellChangeTimes->{
  3.990198709136202*^9, {3.9901987514298153`*^9, 3.990198837232389*^9}},
 CellID->525360965,ExpressionUUID->"58f1659b-7ee7-442a-a512-3c703c611806"],

Cell[TextData[{
 "We will work at 300 MHz throughout, because there ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Lambda]", "\[TildeTilde]", 
    RowBox[{"1", " ", "m"}]}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "2e0444fe-068a-4294-8d86-c873ee86e550"],
 " and the arithmetic is easy: a \"half-wave\" length is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.5`", " ", "m"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "f50f01e7-bca7-4646-aadd-423e17960ab0"],
 ", a \"quarter-wave\" is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.25`", " ", "m"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"e2cb8be1-e443-4846-9259-7a1bb4201512"],
 ", and so on. Everything you learn scales to any frequency \[LongDash] a \
Wi-Fi antenna at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2.4`", " ", "GHz"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"97ff7e03-8b0e-43cd-b9c0-b1e50b361cad"],
 " obeys the same rules, just smaller."
}], "Text",
 CellChangeTimes->{{3.990198867369927*^9, 3.990198939933178*^9}},
 CellID->108776465,ExpressionUUID->"4ac466ff-936d-48d6-b8b7-47ed297cac0f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Half-Wave Dipole", "Subsection",
 CellChangeTimes->{{3.990198680573407*^9, 3.9901986913694277`*^9}, {
  3.990198963356736*^9, 3.990198968772394*^9}},
 CellID->355284138,ExpressionUUID->"e46353b6-cfb0-49a6-aa7d-f52e7f4cce42"],

Cell["\<\
The dipole is the antenna every other antenna is measured against. It is just \
a straight wire, about half a wavelength long, fed in the middle. \
\>", "Text",
 CellChangeTimes->{{3.990198985403613*^9, 3.990199028894496*^9}},
 CellID->2132700097,ExpressionUUID->"3d01f73f-a591-452d-b2a0-c03994fd2136"],

Cell[CellGroupData[{

Cell[TextData[{
 "Let's build one ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0.5`", " ", "m"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "6ceccd6f-a150-41d1-82da-15fe57cc8904"],
 " long (half-wave at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"300", " ", "MHz"}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"d9123e73-06a1-41d6-b255-97e3fec02a09"],
 ") lying along the z-axis:"
}], "MathCaption",
 CellChangeTimes->{{3.990198985403613*^9, 3.9901990099697847`*^9}},
 CellID->1020938953,ExpressionUUID->"ea7b2751-3453-49a2-a6df-fa19b9b306f5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dipole", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Segments\>\"", " ", "->", " ", "21"}], ",", " ", 
      RowBox[{"\"\<Tag\>\"", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\"\<P1\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", 
         RowBox[{"-", "0.25"}]}], "}"}]}], ",", " ", 
      RowBox[{"\"\<P2\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "0.25"}], "}"}]}], ",", " ", 
      RowBox[{"\"\<Radius\>\"", " ", "->", " ", "0.001"}]}], "|>"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"feed", "   ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"<|", 
      RowBox[{
