Cell["The directions of \[Theta] are measured from the wire axis (+z).", \
"Text",
 CellChangeTimes->{{3.9902000073095007`*^9, 3.9902000105374737`*^9}},
 CellID->1273900804,ExpressionUUID->"29773da8-1bdd-410d-a74b-6dfebacd7d04"],

Cell[CellGroupData[{

Cell["Check the extremes:", "MathCaption",
 CellChangeTimes->{{3.990200019275508*^9, 3.990200022596333*^9}},
 CellID->1357442979,ExpressionUUID->"283ceb9d-661d-437b-b192-d99a1aea7970"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gainAt", "[", 
    RowBox[{"t_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"SelectFirst", "[", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"ff", "[", "\"\<FarField\>\"", "]"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"#Theta", " ", "==", " ", "t"}], " ", "&&", " ", 
        RowBox[{"#Phi", " ", "==", " ", "p"}]}], " ", "&"}]}], "]"}], 
    "[", "\"\<GainDB\>\"", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.990200033354188*^9, 3.990200040551766*^9}},
 CellLabel->"In[176]:=",
 CellID->1242538735,ExpressionUUID->"07b7cf5f-471d-40cc-b35a-4a9d082b3adf"],

