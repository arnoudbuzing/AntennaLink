 TaggingRules->{},
 CellTags->"DefaultContent",
 CellID->268961036,ExpressionUUID->"ad473f56-d009-4094-a44e-5890c4fdab56"],

Cell["Set the operating frequency and wave length:", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.990110801349852*^9, 3.99011083433384*^9}},
 CellID->522432881,ExpressionUUID->"f6a84333-8204-46bc-ab06-664f19a3c43d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"frequencyMHz", "=", "300.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lambda", "=", 
   RowBox[{"299.8", "/", "frequencyMHz"}]}], ";"}]}], "Input",
 TaggingRules->{},
 CellLabel->"In[35]:=",
 CellID->2122538764,ExpressionUUID->"054d2011-844c-459f-991d-b0a5ae9c703a"],

Cell["Define the parabolic reflector:", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.990110845359221*^9, 3.990110878035198*^9}},
 CellID->389506322,ExpressionUUID->"dc6a138e-86b0-4180-911d-10893c89f5c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dishWires", "=", 
   RowBox[{"AntennaParabolicReflector", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<FocalLength\>\"", "->", "0.40"}], ",", 
      RowBox[{"\"\<DishRadius\>\"", "->", "0.75"}], ",", 
      RowBox[{"\"\<NumRibs\>\"", "->", "12"}], ",", 
      RowBox[{"\"\<NumRings\>\"", "->", "6"}], ",", 
      RowBox[{"\"\<WireRadius\>\"", "->", "0.002"}]}], " ", "|>"}], "]"}]}], 
  ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9901106227820797`*^9, 3.990110688207735*^9}},
 CellLabel->"In[38]:=",
 CellID->795600612,ExpressionUUID->"8971d6de-f83d-4d13-89d9-6dbb8f9a2007"],

Cell["Define the half-dipole antenna:", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.990110872817485*^9, 3.9901109020021973`*^9}},
 CellID->1060870307,ExpressionUUID->"5bbb9695-9411-4ec3-8260-d82d6d0a8c13"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"feedHalfLength", "=", 
   RowBox[{"0.25", "*", "lambda"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"feedTag", "=", "99"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"feedSegments", "=", "11"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"feedCenterSeg", "=", 
   RowBox[{"Ceiling", "[", 
    RowBox[{"feedSegments", "/", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"feedWire", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Segments\>\"", "->", "feedSegments"}], ",", 
     RowBox[{"\"\<Tag\>\"", "->", "feedTag"}], ",", 
     RowBox[{"\"\<P1\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "feedHalfLength"}], ",", "0.0", ",", "focalLength"}], 
       "}"}]}], ",", 
     RowBox[{"\"\<P2\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"feedHalfLength", ",", "0.0", ",", "focalLength"}], "}"}]}], ",", 
     RowBox[{"\"\<Radius\>\"", "->", "wireRadius"}]}], "|>"}]}], 
  ";"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{
  3.990110684964197*^9, {3.9901108585479116`*^9, 3.9901108615399303`*^9}},
 CellLabel->"In[39]:=",
 CellID->2024556655,ExpressionUUID->"5401446e-3266-4dd9-a5a1-bfa2ccb17a23"],

Cell["Combine the two together:", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.99011090846915*^9, 3.990110912026741*^9}},
 CellID->1766269462,ExpressionUUID->"7a43887b-6a80-418f-8dd0-513c41a1f7d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wires", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"dishWires", ",", 
     RowBox[{"{", "feedWire", "}"}]}], "]"}]}], ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9901106984984407`*^9, 3.990110698923852*^9}},
 CellLabel->"In[44]:=",
 CellID->1227265468,ExpressionUUID->"d48204e2-e575-405b-baa5-2fb2f1f2a404"],

Cell["Define the power source segment:", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9901110031602488`*^9, 3.990111008193408*^9}},
 CellID->1570232265,ExpressionUUID->"3cef2658-9b19-4e55-8a40-54433a1b2c4c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"excitations", "=", 
   RowBox[{"{", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Tag\>\"", "->", "feedTag"}], ",", 
      RowBox[{"\"\<Segment\>\"", "->", "feedCenterSeg"}], ",", 
      RowBox[{"\"\<Voltage\>\"", "->", 
       RowBox[{"1.0", "+", 
        RowBox[{"0.0", " ", "I"}]}]}]}], "|>"}], "}"}]}], ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{3.990110716427394*^9},
 CellLabel->"In[45]:=",
 CellID->979434976,ExpressionUUID->"444a11e5-b095-457a-9457-5677c518bcfa"],

