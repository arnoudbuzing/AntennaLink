Cell[BoxData[
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"AntennaFarFieldMemory", "[", 
    RowBox[{"wires", ",", "200.0", ",", 
     RowBox[{"{", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Tag\>\"", "->", "2"}], ",", 
        RowBox[{"\"\<Segment\>\"", "->", "11"}], ",", 
        RowBox[{"\"\<Voltage\>\"", "->", "1.0"}]}], "|>"}], "}"}], ",", 
