Cell[CellGroupData[{

Cell["Basic Examples", "Subsection",
 TaggingRules->{},
 CellID->816121734,ExpressionUUID->"1d0b2512-5333-434e-9eb0-9b462a2e1a80"],

Cell["\<\
A Yagi-Uda antenna (commonly referred to simply as a Yagi antenna) is a \
directional radio antenna that is highly recognizable and widely used for \
television reception, amateur radio, and various forms of wireless \
communication. This constructs a specific Yagi-Uda antenna:\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.990029555586288*^9, 3.990029571054206*^9}, {
   3.990089822134191*^9, 3.990089822282859*^9}, 3.9900898664207487`*^9, {
   3.990089919535157*^9, 3.9900899311818733`*^9}},
 CellTags->"DefaultContent",
 CellID->489008670,ExpressionUUID->"9c1e6cd7-8775-4a8d-bf5f-e2b6ce3b0f5e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wires", "=", 
   RowBox[{"AntennaYagiUda", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<ReflectorLength\>\"", "->", "0.75"}], ",", 
      RowBox[{"\"\<ReflectorSpacing\>\"", "->", "0.3"}], ",", 
      RowBox[{"\"\<DrivenLength\>\"", "->", "0.705"}], ",", 
      RowBox[{"\"\<DirectorLengths\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"0.645", ",", "0.645", ",", "0.645"}], "}"}]}], ",", 
      RowBox[{"\"\<DirectorSpacings\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"0.3", ",", "0.3", ",", "0.3"}], "}"}]}], ",", 
      RowBox[{"\"\<WireRadius\>\"", "->", "0.005"}], ",", 
      RowBox[{"\"\<Segments\>\"", "->", "21"}]}], "|>"}], "]"}]}], 
  ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.990090167948628*^9, 3.9900902131148653`*^9}},
 CellLabel->"In[3]:=",
 CellID->1900567613,ExpressionUUID->"329e2e06-b1a8-45ab-8706-3ec91d553bc6"],

