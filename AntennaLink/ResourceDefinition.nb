Cell[BoxData[{
 RowBox[{
  RowBox[{"farFieldData", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{"sol", "[", "\"\<FarField\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"maxGain", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Lookup", "[", 
     RowBox[{"farFieldData", ",", "\"\<Gain\>\""}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"minGain", "=", 
   RowBox[{"Min", "[", 
    RowBox[{"Lookup", "[", 
     RowBox[{"farFieldData", ",", "\"\<Gain\>\""}], "]"}], "]"}]}], 
  ";"}]}], "Input",
