Cell["\<\
A helix antenna is a specialized type of radio antenna consisting of a \
conducting wire wound in the shape of a helix (like a corkscrew or a spring). \
It is usually mounted over a flat conductive plane called a ground plane.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9900923457486258`*^9, 3.990092356475225*^9}},
 CellID->1314170509,ExpressionUUID->"6cd6da0b-48b1-4f1c-bee2-0bc7cc763b9e"],

Cell["Define parameters for 300 MHz (wavelength=1 meter):", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9900905909911423`*^9, 3.990090595334956*^9}, 
   3.990090656773899*^9, {3.9900906901296864`*^9, 3.9900906950965233`*^9}},
 CellLabel->"In[25]:=",
 CellID->2100221809,ExpressionUUID->"dade260b-5d41-4036-87b8-e68f328d629b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"freq", "=", "300.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"lambda", "=", 
   RowBox[{"299.79", "/", "freq"}]}], ";"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9900905909911423`*^9, 3.990090595334956*^9}, 
   3.990090656773899*^9, {3.9900906901296864`*^9, 3.990090699816331*^9}},
 CellLabel->"In[12]:=",
 CellID->287158333,ExpressionUUID->"ec40c4ad-420c-45e0-bd98-5df871a67a64"],

Cell["Define axial-mode helix geometry:", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9900905909911423`*^9, 3.990090595334956*^9}, 
   3.990090656773899*^9, {3.9900906901296864`*^9, 3.990090729663849*^9}, {
   3.990090908546459*^9, 3.990090923150185*^9}},
 CellLabel->"In[25]:=",
 CellID->588463921,ExpressionUUID->"9a7156d2-96ff-43fc-a28e-0c6587216aa5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"helixRadius", "=", 
   RowBox[{"lambda", "/", 
    RowBox[{"(", 
     RowBox[{"2", "*", "Pi"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"helixPitch", "=", 
    RowBox[{"0.24", "*", "lambda"}]}], ";"}], "      ", 
  RowBox[{"(*", 
   RowBox[{"Optimal", " ", "pitch", " ", 
    RowBox[{"is", "~", "0.24"}], " ", "lambda"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"numTurns", "=", "18.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"helixWires", "=", 
   RowBox[{"AntennaHelix", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Radius\>\"", "->", "helixRadius"}], ",", 
      RowBox[{"\"\<Pitch\>\"", "->", "helixPitch"}], ",", 
      RowBox[{"\"\<Turns\>\"", "->", "numTurns"}], ",", 
      RowBox[{"\"\<WireRadius\>\"", "->", "0.002"}], ",", 
      RowBox[{"\"\<SegmentsPerTurn\>\"", "->", "21"}]}], "|>"}], "]"}]}], 
  ";"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9900905909911423`*^9, 3.990090595334956*^9}, 
   3.990090656773899*^9, {3.9900906901296864`*^9, 3.990090701464078*^9}, {
   3.990090734964548*^9, 3.990090736285699*^9}},
 CellLabel->"In[14]:=",
 CellID->1090713371,ExpressionUUID->"d94b3408-24e8-479c-9b21-e0aa63bf90f9"],

Cell["Define the ground plane geometry:", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9900905909911423`*^9, 3.990090595334956*^9}, 
   3.990090656773899*^9, {3.9900906901296864`*^9, 3.990090701464078*^9}, {
   3.990090734964548*^9, 3.9900907501958103`*^9}, 3.990090932207676*^9, {
   3.990092386862904*^9, 3.9900923961478987`*^9}},
 CellLabel->"In[25]:=",
 CellID->1430238572,ExpressionUUID->"d75b8957-b330-446c-9c43-7183ff657e22"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"groundRadius", "=", 
   RowBox[{"0.8", "*", "lambda"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"numRadials", "=", "36"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"groundWires", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Segments\>\"", "->", "11"}], ",", 
       RowBox[{"\"\<Tag\>\"", "->", 
        RowBox[{"100", "+", "i"}]}], ",", 
       RowBox[{"\"\<P1\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.0", ",", "0.0", ",", "0.0"}], "}"}]}], ",", 
       RowBox[{"\"\<P2\>\"", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"groundRadius", "*", 
           RowBox[{"Cos", "[", 
            RowBox[{"i", "*", "2", " ", 
             RowBox[{"Pi", "/", "numRadials"}]}], "]"}]}], ",", 
          RowBox[{"groundRadius", "*", 
           RowBox[{"Sin", "[", 
            RowBox[{"i", "*", "2", " ", 
             RowBox[{"Pi", "/", "numRadials"}]}], "]"}]}], ",", "0.0"}], 
         "}"}]}], ",", 
       RowBox[{"\"\<Radius\>\"", "->", "0.002"}]}], "|>"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "numRadials"}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.9900905909911423`*^9, 3.990090595334956*^9}, 
   3.990090656773899*^9, {3.9900906901296864`*^9, 3.990090701464078*^9}, {
   3.990090734964548*^9, 3.990090757492841*^9}},
 CellLabel->"In[18]:=",
 CellID->1235218733,ExpressionUUID->"4c3b48d8-f23f-4e1a-8588-a4ada2281fb6"],

Cell["Combine all wires:", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9900905909911423`*^9, 3.990090595334956*^9}, 
   3.990090656773899*^9, {3.9900906901296864`*^9, 3.990090701464078*^9}, {
   3.990090734964548*^9, 3.9900907624818296`*^9}, 3.9900909351835823`*^9},
 CellLabel->"In[25]:=",
 CellID->205011830,ExpressionUUID->"353114eb-a010-4ee0-8245-3c28e085c8dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wires", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"helixWires", ",", "groundWires"}], "]"}]}], ";"}]], "Input",
