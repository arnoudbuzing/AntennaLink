Cell["\<\
Extract minimum and maximum gain for the plot legend scaling:\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9900294940232563`*^9, 3.990029542609303*^9}, {
  3.9900295878858624`*^9, 3.990029647093799*^9}},
