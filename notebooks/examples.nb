Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Define", " ", "a", " ", "simple", " ", "half"}], "-", 
    RowBox[{"wave", " ", "dipole"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"wires", "=", 
     RowBox[{"{", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Segments\>\"", "->", "11"}], ",", 
        RowBox[{"\"\<Tag\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<P1\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", 
           RowBox[{"-", "0.25"}]}], "}"}]}], ",", 
        RowBox[{"\"\<P2\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0.25"}], "}"}]}], ",", 
        RowBox[{"\"\<Radius\>\"", "->", "0.001"}]}], "|>"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"excitations", "=", 
     RowBox[{"{", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Tag\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<Segment\>\"", "->", "6"}], ",", 
        RowBox[{"\"\<Voltage\>\"", "->", 
         RowBox[{"1.0", "+", 
          RowBox[{"0.0", "*", "I"}]}]}]}], "|>"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Solve", " ", "in", " ", "memory", " ", "at", " ", "299.79", " ", "MHz"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"AntennaSolveMemory", "[", 
      RowBox[{"wires", ",", "299.79", ",", "excitations"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"View", " ", "the", " ", "currents", " ", "dataset"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"results", "[", "\"\<Currents\>\"", "]"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Input", " ", "impedance", " ", 
     RowBox[{"(", 
      RowBox[{"and", " ", "drive", " ", 
       RowBox[{
        RowBox[{"voltage", "/", "current"}], "/", "power"}]}], ")"}], " ", 
     "at", " ", "each", " ", "excited", " ", "segment"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"results", "[", "\"\<InputParameters\>\"", "]"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"e", ".", "g", ".", "ZInput"}], "->", 
     RowBox[{"83.66", "+", 
      RowBox[{
      "47.09", " ", "I", " ", "ohms", " ", "for", " ", "this", " ", 
