Cell[BoxData[{
 RowBox[{
  RowBox[{"monopole", "=", 
   RowBox[{"{", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Segments\>\"", "->", "9"}], ",", 
      RowBox[{"\"\<Tag\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<P1\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
      RowBox[{"\"\<P2\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0.25"}], "}"}]}], ",", 
      RowBox[{"\"\<Radius\>\"", "->", "0.001"}]}], "|>"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"feed", "=", 
   RowBox[{"{", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Tag\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<Segment\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<Voltage\>\"", "->", "1.0"}]}], "|>"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"perfectGnd", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Type\>\"", "->", "\"\<Perfect\>\""}], ",", 
      RowBox[{"\"\<ConnectWires\>\"", "->", "True"}]}], "|>"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Single", "-", 
    RowBox[{"frequency", " ", "impedance", " ", 
     RowBox[{"(", 
      RowBox[{"\[TildeTilde]", 
       RowBox[{"42", "+", 
        RowBox[{"j24", " ", "\[CapitalOmega]"}]}]}], ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"AntennaSolveMemory", "[", 
    RowBox[{"monopole", ",", "299.79", ",", "feed", ",", 
     RowBox[{"\"\<Ground\>\"", "->", "perfectGnd"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"sol", "[", "\"\<InputParameters\>\"", "]"}], "]"}], "[", 
   RowBox[{"[", 
    RowBox[{"1", ",", "\"\<ZInput\>\""}], "]"}], "]"}], "\[IndentingNewLine]",
   "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Sweep", " ", "250"}], "\[Dash]", 
    RowBox[{
    "350", " ", "MHz", " ", "against", " ", "a", " ", "50", " ", 
     "\[CapitalOmega]", " ", "reference"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sweep", "=", 
    RowBox[{"AntennaSweepMemory", "[", 
     RowBox[{"monopole", ",", 
      RowBox[{"Range", "[", 
       RowBox[{"250.0", ",", "350.0", ",", "2.0"}], "]"}], ",", "feed", ",", 
      RowBox[{"\"\<Ground\>\"", "->", "perfectGnd"}], ",", 
      RowBox[{"\"\<ReferenceImpedance\>\"", "->", "50.0"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Plot", " ", "VSWR", " ", "vs", " ", "frequency"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ListLinePlot", "[", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"sweep", "[", 
      RowBox[{"All", ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"#Frequency", ",", "#VSWR"}], "}"}], "&"}]}], "]"}], "]"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{"1", ",", "5"}], "}"}]}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Frequency (MHz)\>\"", ",", "\"\<VSWR\>\""}], "}"}]}], ",", 
    
    RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
    RowBox[{"GridLines", "->", 
     RowBox[{"{", 
      RowBox[{"None", ",", 
       RowBox[{"{", "2", "}"}]}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Plot", " ", "return", " ", "loss", " ", "S11", " ", 
    RowBox[{"(", "dB", ")"}], " ", "vs", " ", "frequency"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"sweep", "[", 
     RowBox[{"All", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#Frequency", ",", "#S11"}], "}"}], "&"}]}], "]"}], "]"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Frequency (MHz)\>\"", ",", "\"\<S11 (dB)\>\""}], "}"}]}], ",", 
   RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}]}], "]"}]}], "Input",
