Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"yagi", "=", 
    RowBox[{"AntennaYagiUda", "[", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<ReflectorLength\>\"", "->", "0.50"}], ",", 
       RowBox[{"\"\<ReflectorSpacing\>\"", "->", "0.15"}], ",", 
       RowBox[{"\"\<DrivenLength\>\"", "->", "0.47"}], ",", 
       RowBox[{"\"\<DirectorLengths\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.44", ",", "0.43", ",", "0.42"}], "}"}]}], ",", 
       RowBox[{"\"\<DirectorSpacings\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0.15", ",", "0.20", ",", "0.20"}], "}"}]}], ",", 
       RowBox[{"\"\<Segments\>\"", "->", "33"}]}], "|>"}], "]"}]}], ";"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "driven", " ", "element", " ", "is", " ", "Tag", " ", "2"}], ";", 
    RowBox[{"feed", " ", "its", " ", "center", " ", "segment"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"feed", "=", 
    RowBox[{"{", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Tag\>\"", "->", "2"}], ",", 
       RowBox[{"\"\<Segment\>\"", "->", "17"}], ",", 
       RowBox[{"\"\<Voltage\>\"", "->", "1.0"}]}], "|>"}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ff", "=", 
    RowBox[{"AntennaFarFieldMemory", "[", 
     RowBox[{"yagi", ",", "300.0", ",", "feed", ",", 
      RowBox[{"Range", "[", 
       RowBox[{"0.0", ",", "180.0", ",", "5.0"}], "]"}], ",", 
      RowBox[{"Range", "[", 
       RowBox[{"0.0", ",", "270.0", ",", "5.0"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "3", "D", " ", "pattern", " ", "shows", " ", "the", " ", "forward", " ", 
    "beam", " ", "toward", " ", "the", " ", "directors"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"AntennaPlotPattern3D", "[", 
   RowBox[{"ff", ",", 
    RowBox[{"\"\<ShowGeometry\>\"", "->", "True"}]}], "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Azimuth", " ", "cut", " ", "through", " ", "the", " ", "beam", " ", 
    RowBox[{"(", 
     RowBox[{"theta", "=", 
      RowBox[{"90", " ", "deg", " ", "plane"}]}], ")"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"AntennaPlotPattern2D", "[", 
   RowBox[{"ff", ",", 
    RowBox[{"\"\<Plane\>\"", "->", "\"\<Azimuth\>\""}], ",", 
    RowBox[{"\"\<DynamicRange\>\"", "->", "30.0"}]}], "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Figures", " ", "of", " ", "merit", " ", "from", " ", "the", " ", 
    "dataset"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"ffData", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{"ff", "[", "\"\<FarField\>\"", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gainAt", "[", 
    RowBox[{"t_", ",", "p_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"SelectFirst", "[", 
     RowBox[{"ffData", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"#Theta", "==", "t"}], "&&", 
        RowBox[{"#Phi", "==", "p"}]}], "&"}]}], "]"}], "[", "\"\<GainDB\>\"", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"peakGain", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"ffData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "\"\<GainDB\>\""}], "]"}], "]"}], "]"}]}], "      ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"~", "8"}], "\[Dash]", 
    RowBox[{"10", " ", "dBi"}]}], "*)"}]}], "\n", 
 RowBox[{"frontToBack", "=", 
  RowBox[{
   RowBox[{"gainAt", "[", 
    RowBox[{"90", ",", "90"}], "]"}], "-", 
   RowBox[{"gainAt", "[", 
    RowBox[{"90", ",", "270"}], "]"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"forward", " ", 
     RowBox[{"(", 
      RowBox[{"+", "Y"}], ")"}], " ", "minus", " ", "back", " ", 
     RowBox[{"(", 
      RowBox[{"\[Minus]", "Y"}], ")"}]}], "*)"}]}]}]}], "Input",
