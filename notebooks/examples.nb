   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"Abs", "[", "eR", "]"}], "-", 
     RowBox[{"Abs", "[", "eL", "]"}]}], "]"}]}]}], "\n", 
 RowBox[{"axialRatioDB", "=", 
  RowBox[{"20", " ", 
   RowBox[{"Log10", "[", "axialRatio", "]"}]}]}]}], "Input",
