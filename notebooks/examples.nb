Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Helix", " ", "aligned", " ", "along", " ", "the", " ", "Z"}], "-", 
    RowBox[{"axis", " ", "using", " ", "positional", " ", "arguments"}]}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"helixWires", "=", 
     RowBox[{"AntennaHelix", "[", 
      RowBox[{"0.08", ",", 
       RowBox[{"(*", 
        RowBox[{"Coil", " ", "radius"}], "*)"}], "0.10", ",", 
       RowBox[{"(*", 
        RowBox[{"Turn", " ", "pitch"}], "*)"}], "5.0", ",", 
       RowBox[{"(*", 
        RowBox[{"Number", " ", "of", " ", "turns"}], "*)"}], "0.001", ",", 
       RowBox[{"(*", 
        RowBox[{"Wire", " ", "radius"}], "*)"}], "16"}], "     ", 
      RowBox[{"(*", 
       RowBox[{"Segments", " ", "per", " ", "turn"}], "*)"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Alternatively", ",", 
     RowBox[{"using", " ", "an", " ", "Association"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"helixWires", "=", 
     RowBox[{"AntennaHelix", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Radius\>\"", "->", "0.08"}], ",", 
        RowBox[{"\"\<Pitch\>\"", "->", "0.10"}], ",", 
        RowBox[{"\"\<Turns\>\"", "->", "5.0"}], ",", 
        RowBox[{"\"\<WireRadius\>\"", "->", "0.001"}], ",", 
        RowBox[{"\"\<SegmentsPerTurn\>\"", "->", "16"}]}], "|>"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.990192117558486*^9, 3.990192117558578*^9}},
