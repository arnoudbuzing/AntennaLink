Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Solve", " ", "helical", " ", "antenna"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"AntennaSolveMemory", "[", 
      RowBox[{"helixWires", ",", "300.0", ",", 
       RowBox[{"{", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Tag\>\"", "->", "1"}], ",", 
          RowBox[{"\"\<Segment\>\"", "->", "1"}], ",", 
          RowBox[{"\"\<Voltage\>\"", "->", "1.0"}]}], "|>"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Render", " ", "colored", " ", "by", " ", "current", " ", "magnitude", " ",
      "with", " ", "excitation", " ", "bases", " ", "highlighted"}], "*)"}], "\[IndentingNewLine]", 
