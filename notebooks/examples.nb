Cell[BoxData[{
 RowBox[{
  RowBox[{"helix", "=", 
   RowBox[{"AntennaHelix", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Radius\>\"", "->", "0.05"}], ",", 
      RowBox[{"\"\<Pitch\>\"", "->", "0.05"}], ",", 
      RowBox[{"\"\<Turns\>\"", "->", "6"}], ",", 
      RowBox[{"\"\<SegmentsPerTurn\>\"", "->", "64"}]}], "|>"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"feed", "=", 
    RowBox[{"{", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Tag\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<Segment\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<Voltage\>\"", "->", "1.0"}]}], "|>"}], "}"}]}], ";"}], 
  "   ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"tag", " ", "1"}], "=", 
    RowBox[{"base", " ", "segment"}]}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ff", "=", 
    RowBox[{"AntennaFarFieldMemory", "[", 
     RowBox[{"helix", ",", "1000.0", ",", "feed", ",", 
      RowBox[{"Range", "[", 
       RowBox[{"0.0", ",", "180.0", ",", "5.0"}], "]"}], ",", 
      RowBox[{"Range", "[", 
       RowBox[{"0.0", ",", "270.0", ",", "5.0"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Geometry", " ", "colored", " ", "by", " ", "current"}], ",", 
    RowBox[{"and", " ", "the", " ", "3", "D", " ", "pattern", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"endfire", " ", "beam", " ", "toward"}], "+", "Z"}], ")"}]}]}],
    "*)"}]}], "\n", 
 RowBox[{"AntennaPlotGeometry", "[", 
  RowBox[{
   RowBox[{"AntennaSolveMemory", "[", 
    RowBox[{"helix", ",", "1000.0", ",", "feed"}], "]"}], ",", 
   RowBox[{"\"\<ColorFunction\>\"", "->", "\"\<Phase\>\""}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"AntennaPlotPattern3D", "[", 
   RowBox[{"ff", ",", 
    RowBox[{"\"\<ShowGeometry\>\"", "->", "True"}]}], "]"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Axial", " ", "ratio", " ", "on", " ", "boresight", " ", 
     RowBox[{"(", 
      RowBox[{"theta", "=", "0"}], ")"}], " ", "from", " ", "the", " ", 
     "complex", " ", "field", " ", 
     RowBox[{"components", ".", "Decompose"}], " ", "into", " ", 
     RowBox[{"RHCP", "/", "LHCP"}]}], ";", 
    RowBox[{"AR", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"|", "R", "|", 
          RowBox[{"+", 
           RowBox[{"|", "L", "|"}]}]}], ")"}], "/"}], " ", "||", "R"}], "|", 
      RowBox[{"-", 
       RowBox[{"|", 
        RowBox[{"L", "||", 
         RowBox[{"(", 
          RowBox[{"1", "=", 
           RowBox[{"perfect", " ", "circular"}]}], ")"}]}]}]}]}]}]}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"boresight", "=", 
   RowBox[{"SelectFirst", "[", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"ff", "[", "\"\<FarField\>\"", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"#Theta", "==", "0.0"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"eth", ",", "eph"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"boresight", "[", "\"\<ETheta\>\"", "]"}], ",", 
     RowBox[{"boresight", "[", "\"\<EPhi\>\"", "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"eR", ",", "eL"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"eth", "-", 
        RowBox[{"I", " ", "eph"}]}], ")"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"eth", "+", 
        RowBox[{"I", " ", "eph"}]}], ")"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"axialRatio", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Abs", "[", "eR", "]"}], "+", 
